# Inventario de ejemplo. Cada tabla es un grupo; la clave `hosts` lista los
# destinos en formato host:puerto. Los nombres de aca son de los dominios
# reservados para ejemplos (RFC 2606): cambialos por los tuyos.
#
# `expect` fija el nombre que se manda en SNI y contra el que se valida el
# certificado. Sirve para los nodos que estan detras de un CNAME y cuyo
# certificado nunca lleva el nombre propio del nodo. Se puede poner a nivel de
# grupo, o por entrada con la forma { addr = "...", expect = "..." }.
#
# Cada nombre se expande en una fila por cada registro A y AAAA que resuelva.
#
# Los puertos que negocian STARTTLS se detectan solos (25 y 587 smtp, 143 imap,
# 110 pop3); `starttls` pisa esa inferencia y `starttls = "none"` fuerza TLS
# implicito.

[frontends]
expect = "rrdp.example.net"
hosts = [
  "fe-1.rrdp.example.net:443",
  "fe-2.rrdp.example.net:443",
]

[rpki-load-balancers]
expect = "rrdp.example.net"
hosts = [
  "lb-1.example.net:443",
  "lb-2.example.net:443",
  "lb-3.example.net:443",
]

[email]
hosts = [
  "mail.example.net:25",
  "mail.example.net:993",
  "mx.example.org:993",
  "mx.example.org:465",
  # Una entrada puede traer su propio expect y pisar el del grupo:
  # { addr = "webmail.example.net:443", expect = "mail.example.net" },
  # Y su propio starttls, para un puerto que no se infiere o para forzar
  # TLS implicito en uno que si:
  # { addr = "smtp.example.net:2525", starttls = "smtp" },
  # { addr = "raro.example.net:143",  starttls = "none" },
]
